# Public site URL - used for metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://ebikes.civitasholdings.co.za

# Afrihost PHP bridge (public/php). Leave unset locally to use graceful
# "backend not connected yet" fallback states on lead-capture forms.
EBIKES_BRIDGE_URL=https://ebikes.civitasholdings.co.za/php/
EBIKES_API_KEY=
EBIKES_API_TIMEOUT_MS=10000

# The Next.js app calls the protected PHP health check at:
#   ${EBIKES_BRIDGE_URL}/health.php
